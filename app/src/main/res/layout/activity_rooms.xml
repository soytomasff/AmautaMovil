<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <include layout="@layout/view_brand_header" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/rooms_title" android:textStyle="bold" android:textSize="26sp"
                android:textColor="@color/ink" />
            <TextView android:id="@+id/roomTotals" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="15sp"
                android:textColor="@color/muted" android:layout_marginTop="5dp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:scrollbars="none">
                <RadioGroup android:id="@+id/roomFilters" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal">
                    <RadioButton android:id="@+id/filterAll" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:text="@string/filter_all" />
                    <RadioButton android:id="@+id/filterFree" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:text="@string/filter_free" />
                    <RadioButton android:id="@+id/filterOccupied" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:text="@string/filter_occupied" />
                    <RadioButton android:id="@+id/filterCleaning" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:text="@string/filter_cleaning" />
                    <RadioButton android:id="@+id/filterMaintenance" android:layout_width="wrap_content"
                        android:layout_height="48dp" android:text="@string/filter_maintenance" />
                </RadioGroup>
            </HorizontalScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp">
                <Button android:id="@+id/refreshButton" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="@string/refresh" />
            </LinearLayout>
            <TextView android:id="@+id/roomsMessage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginVertical="12dp"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <LinearLayout android:id="@+id/roomList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_navigation" />
    <Button android:id="@+id/logoutButton" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="20dp" android:layout_marginVertical="6dp"
        android:text="@string/logout" />
</LinearLayout>
