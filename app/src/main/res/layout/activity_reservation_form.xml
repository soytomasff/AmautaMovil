<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <include layout="@layout/view_brand_header" />
            <TextView android:id="@+id/reservationFormTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="25sp"
                android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reservation_guest_label" android:textStyle="bold"
                android:textColor="@color/ink" android:layout_marginTop="22dp" />
            <Spinner android:id="@+id/reservationGuest" android:layout_width="match_parent"
                android:layout_height="56dp" android:background="@drawable/bg_card"
                android:paddingHorizontal="12dp" android:contentDescription="@string/reservation_guest_label" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reservation_room_label" android:textStyle="bold"
                android:textColor="@color/ink" android:layout_marginTop="18dp" />
            <Spinner android:id="@+id/reservationRoom" android:layout_width="match_parent"
                android:layout_height="56dp" android:background="@drawable/bg_card"
                android:paddingHorizontal="12dp" android:contentDescription="@string/reservation_room_label" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reservation_entry_label" android:textStyle="bold"
                android:textColor="@color/ink" android:layout_marginTop="18dp" />
            <Button android:id="@+id/reservationEntry" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="@string/select_entry_date" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reservation_exit_label" android:textStyle="bold"
                android:textColor="@color/ink" android:layout_marginTop="18dp" />
            <Button android:id="@+id/reservationExit" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:text="@string/select_exit_date" />
            <TextView android:id="@+id/reservationFormState" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:textColor="@color/muted" />
            <Spinner android:id="@+id/reservationEditState" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_card" android:paddingHorizontal="12dp"
                android:visibility="gone" android:contentDescription="@string/reservation_filter_label" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/reservation_availability_note"
                android:textColor="@color/muted" android:textSize="13sp" />
            <TextView android:id="@+id/reservationFormMessage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/saveReservation" android:layout_width="match_parent"
                android:layout_height="54dp" android:layout_marginTop="20dp"
                android:text="@string/save_reservation" android:enabled="false" />
            <Button android:id="@+id/cancelReservationForm"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="@string/back_to_reservations" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_navigation" />
</LinearLayout>
