<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <include layout="@layout/view_brand_header" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/reservations_title" android:textSize="25sp"
                android:textStyle="bold" android:textColor="@color/ink" />
            <Button android:id="@+id/newReservation" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="14dp"
                android:text="@string/new_reservation" />
            <EditText android:id="@+id/reservationSearch" android:layout_width="match_parent"
                android:layout_height="54dp" android:layout_marginTop="12dp"
                android:hint="@string/reservation_search_hint" android:inputType="text"
                android:singleLine="true" />
            <Spinner android:id="@+id/reservationStatusFilter" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="8dp"
                android:background="@drawable/bg_card" android:paddingHorizontal="12dp"
                android:contentDescription="@string/reservation_filter_label" />
            <Button android:id="@+id/refreshReservations"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="@string/refresh" android:layout_marginTop="12dp" />
            <TextView android:id="@+id/reservationsMessage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginVertical="12dp"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <LinearLayout android:id="@+id/reservationList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_navigation" />
    <Button android:id="@+id/logoutButton" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginHorizontal="20dp" android:layout_marginVertical="6dp"
        android:text="@string/logout" />
</LinearLayout>
