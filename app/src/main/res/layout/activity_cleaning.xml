<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/surface">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/contentColumn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <include layout="@layout/view_brand_header" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/cleaning_title" android:textSize="26sp" android:textStyle="bold"
                android:textColor="@color/ink" />
            <TextView android:id="@+id/cleaningSummary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textColor="@color/muted" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/cleaning_contract_note"
                android:textColor="@color/muted" />
            <EditText android:id="@+id/cleaningSearch" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="12dp"
                android:hint="@string/cleaning_search" android:inputType="text"
                android:singleLine="true" />
            <Spinner android:id="@+id/cleaningFilter" android:layout_width="match_parent"
                android:layout_height="52dp" android:contentDescription="@string/cleaning_filter" />
            <Button android:id="@+id/cleaningRefresh" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="@string/refresh" />
            <Button android:id="@+id/cleaningLogout" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:visibility="gone" android:text="@string/logout" />
            <ProgressBar android:id="@+id/cleaningProgress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:visibility="gone" />
            <TextView android:id="@+id/cleaningMessage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginVertical="12dp"
                android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <LinearLayout android:id="@+id/cleaningList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_navigation" />
</LinearLayout>
